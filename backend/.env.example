PORT=4000
MONGO_URI=mongodb://localhost:27017/turismo

JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=turismo-api
JWT_AUDIENCE=turismo-frontend
ACCESS_TTL=8h
REFRESH_TTL=7d

COOKIE_DOMAIN=.example.com
ALLOWED_ORIGINS=https://example.com,https://www.example.com

PUBLIC_BASE_URL=https://example.com
FRONTEND_BASE_URL=https://example.com
HOLIDAYS_FILE=./src/config/holidays.pe.json

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Vicuña Adventures Admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FORCE_PROMOTE=
ADMIN_RESET_PASSWORD=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM="Vicuña Adventures" <mailer@example.com>
SMTP_REPLY_TO=contact@example.com
SMTP_ALLOW_INVALID_CERTS=0

LOGO_PATH=/var/www/turismo-app/frontend/public/icon.png
BROCHURE_LOGO_PATH=/icon.png
PAYMENT_WA_DEFAULT=999999999
